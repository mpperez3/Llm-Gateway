     return CompletionTokenUsageInfo(reasoning_tokens=reasoning_tokens)
 
 
+def _tq_llamacpp_timings(final_res) -> dict[str, float] | None:
+    """llama.cpp-compatible timings block (llama-swap reads prompt/predicted_per_second)."""
+    try:
+        st = getattr(final_res, "metrics", None)
+        if st is None:
+            return None
+        gen_n = int(getattr(st, "num_generation_tokens", 0) or 0)
+        pids = getattr(final_res, "prompt_token_ids", None)
+        prompt_n = len(pids) if pids else 0
+        ft = float(getattr(st, "first_token_ts", 0.0) or 0.0)
+        sched = float(getattr(st, "scheduled_ts", 0.0) or 0.0)
+        lt = float(getattr(st, "last_token_ts", 0.0) or 0.0)
+        if gen_n <= 0 or prompt_n <= 0 or ft <= 0.0 or lt <= 0.0:
+            return None
+        p_ms = max(0.0, (ft - sched) * 1000.0)
+        d_ms = max(0.0, (lt - ft) * 1000.0)
+        return {
+            "prompt_n": float(prompt_n),
+            "prompt_ms": p_ms,
+            "prompt_per_token_ms": (p_ms / prompt_n) if prompt_n else 0.0,
+            "prompt_per_second": (prompt_n / (p_ms / 1000.0)) if p_ms > 0 else 0.0,
+            "predicted_n": float(gen_n),
+            "predicted_ms": d_ms,
+            "predicted_per_token_ms": (d_ms / gen_n) if gen_n else 0.0,
+            "predicted_per_second": (gen_n / (d_ms / 1000.0)) if d_ms > 0 else 0.0,
+        }
+    except Exception:
+        return None
+
+
